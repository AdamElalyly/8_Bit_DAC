`include "constants.vams"
`include "disciplines.vams"

module dac_ramp_stim(B7, B6, B5, B4, B3, B2, B1, B0, B4_b, B3_b, B2_b, B1_b, B0_b);
  output B7, B6, B5, B4, B3, B2, B1, B0;
  output B4_b, B3_b, B2_b, B1_b, B0_b;
  electrical B7, B6, B5, B4, B3, B2, B1, B0;
  electrical B4_b, B3_b, B2_b, B1_b, B0_b;

  parameter real t_step   = 1.0e-6;  // 1 us per code for full settling[cite: 2, 3]
  parameter real trf      = 1.0e-9;  // 1 ns edge transition[cite: 2]
  parameter real td_cross = 0.2e-9;  // Crossing shift delay (0.2 ns lowers PMOS crosspoint)
  parameter real vdd      = 1.2;

  integer code;

  analog begin
    @(initial_step) begin
      code = 0;
    end

    // Increment code every 1 us from 0 up to 255[cite: 2]
    @(timer(t_step, t_step)) begin
      if (code < 255)
        code = code + 1;
    end

    // True bits (zero delay)[cite: 2]
    V(B7)   <+ transition(((code >> 7) & 1) ? vdd : 0.0, 0.0, trf, trf);
    V(B6)   <+ transition(((code >> 6) & 1) ? vdd : 0.0, 0.0, trf, trf);
    V(B5)   <+ transition(((code >> 5) & 1) ? vdd : 0.0, 0.0, trf, trf);
    V(B4)   <+ transition(((code >> 4) & 1) ? vdd : 0.0, 0.0, trf, trf);
    V(B3)   <+ transition(((code >> 3) & 1) ? vdd : 0.0, 0.0, trf, trf);
    V(B2)   <+ transition(((code >> 2) & 1) ? vdd : 0.0, 0.0, trf, trf);
    V(B1)   <+ transition(((code >> 1) & 1) ? vdd : 0.0, 0.0, trf, trf);
    V(B0)   <+ transition(((code >> 0) & 1) ? vdd : 0.0, 0.0, trf, trf);

    // Complement bits (delayed by td_cross to shift PMOS crosspoint lower)
    V(B4_b) <+ transition(((code >> 4) & 1) ? 0.0 : vdd, td_cross, trf, trf);
    V(B3_b) <+ transition(((code >> 3) & 1) ? 0.0 : vdd, td_cross, trf, trf);
    V(B2_b) <+ transition(((code >> 2) & 1) ? 0.0 : vdd, td_cross, trf, trf);
    V(B1_b) <+ transition(((code >> 1) & 1) ? 0.0 : vdd, td_cross, trf, trf);
    V(B0_b) <+ transition(((code >> 0) & 1) ? 0.0 : vdd, td_cross, trf, trf);
  end
endmodule